{
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Vitesse Dark Soft",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.productIconTheme": "icons-carbon",
  "editor.fontFamily": "JetBrains Mono, SFMono-Regular, Menlo, Monaco, Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.tabSize": 2,
  "editor.wordWrap": "off",
  "editor.minimap.enabled": true,
  "editor.inlayHints.enabled": "on",
  "editor.stickyScroll.enabled": true,
  "diffEditor.wordWrap": "on",
  "diffEditor.ignoreTrimWhitespace": false,
  "files.autoSave": "off",
  "editor.formatOnSave": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/target/**": true,
    "**/dist/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/target": true,
    "**/dist": true,
    "**/build": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true
  },
  "git.autofetch": false,
  "python.useEnvironmentsExtension": true,
  "python-envs.alwaysUseUv": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[javascript][javascriptreact][typescript][typescriptreact][vue][json][jsonc][css][scss][html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "redhat.telemetry.enabled": true
}
